# Dependencies (each workspace has its own node_modules under npm workspaces)
node_modules/

# Build output
dist/
dist-cjs/
build/
web-build/

# Expo (packages/mobile-app)
.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Env files — never commit real secrets. .env.example files ARE meant to be committed.
.env
.env.local
.env.*.local

# WhatsApp Baileys gateway — runtime session credentials (QR-linked device)
# NEVER commit auth_state: it contains the live WhatsApp session keys.
packages/whatsapp-baileys/auth_state/

# Editor/backup cruft
*.bak
*.tmp

# OS/editor cruft
.DS_Store
*.log
npm-debug.log*
/packages/mobile-app/expo-log.txt

# Vitest/coverage
coverage/
