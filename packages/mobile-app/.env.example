# Required — Supabase (grátis)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — Sentry (grátis até 5K erros/mês)
EXPO_PUBLIC_SENTRY_DSN=

# Optional — PostHog (grátis até 1M eventos/mês)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ai-relay secrets — só precisa de UMA API key pra funcionar:
# ┌─────────────────────────────────────────────────────────┐
# │  RECOMENDADO: Groq (GRÁTIS, tem Whisper pra STT)       │
# │  Cadastro: https://console.groq.com                     │
# │  supabase secrets set GROQ_API_KEY=gsk_...              │
# ├─────────────────────────────────────────────────────────┤
# │  Alternativa: OpenCode Zen (vários modelos)             │
# │  Cadastro: https://opencode.ai                          │
# │  supabase secrets set OPENCODE_API_KEY=...              │
# ├─────────────────────────────────────────────────────────┤
# │  Outras alternativas (pagas):                           │
# │  supabase secrets set OPENAI_API_KEY=sk-...             │
# │  supabase secrets set ANTHROPIC_API_KEY=sk-ant-...      │
# │  supabase secrets set OPENROUTER_API_KEY=sk-or-...      │
# └─────────────────────────────────────────────────────────┘
