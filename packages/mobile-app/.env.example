# Required — Supabase (grátis)
EXPO_PUBLIC_SUPABASE_URL=https://kmfmeewibravdsxemzuj.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — Sentry (grátis até 5K erros/mês)
EXPO_PUBLIC_SENTRY_DSN=

# Optional — PostHog (grátis até 1M eventos/mês)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Voz (Fase 1) ─────────────────────────────────────────────────────
# Wake word "Ok Orun": o app fica sempre ouvindo (VAD) e transcreve a fala
# via ai-relay (Groq Whisper, grátis). Nenhuma variável necessária.
# Obs.: Picovoice descontinuou o free tier (30/06/2026) — não usar Porcupine.

# ─── Spotify (Fase 2) ─────────────────────────────────────────────────
# Crie um app em https://developer.spotify.com/dashboard → Settings →
# Redirect URIs: adicione "orun-os://spotify" e "orun-os://spotify-callback"
# REQUER conta Spotify Premium para play/pause/pular via API.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=

# ─── WhatsApp (Fase 3) ────────────────────────────────────────────────
# Roda via o gateway packages/whatsapp-baileys (no PC/servidor) — o mobile
# só consome as mensagens pelo Supabase Realtime. Nenhuma variável aqui.
